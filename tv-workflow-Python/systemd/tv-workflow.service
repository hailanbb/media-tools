[Unit]
Description=TV Series Organization Workflow Daemon (Python)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/tv-workflow-Python
ExecStart=/usr/bin/python3 /opt/tv-workflow-Python/bin/daemon.py
Restart=always
RestartSec=10
StandardOutput=append:/opt/tv-workflow-Python/logs/systemd.log
StandardError=append:/opt/tv-workflow-Python/logs/systemd.log

[Install]
WantedBy=multi-user.target
