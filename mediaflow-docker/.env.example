# ┌────────────────────────────────────────────────────────┐
# │  MediaFlow 环境配置                                     │
# │  复制为 .env 并填写真实值后使用                          │
# │  所有变量以 MF_ 前缀，大小写不敏感                       │
# └────────────────────────────────────────────────────────┘

# ── 基础配置 ──────────────────────────────────────────────
MF_DEBUG=false
MF_PORT=8080
MF_DATA_DIR=/app/data

# 警告：网页端暂无登录框，普通浏览器访问请保持注释留空（仅反代层自动注入请求头或纯 API 调用使用）
# MF_AUTH_TOKEN=your-secret-token

# ── CloudDrive2 连接（必填）────────────────────────────────
# gRPC-Web 端点 + Bearer Token 认证
MF_CD2_URL=https://your-cd2-host:port
MF_CD2_TOKEN=your-cd2-token

# ── MoviePilot 连接（必填）────────────────────────────────
# REST API + X-API-KEY 认证
MF_MP_URL=https://your-mp-host:port
MF_MP_TOKEN=your-mp-api-key

# ── TMDB（可选，MoviePilot 已内置代理）─────────────────────
# MF_TMDB_API_KEY=your-tmdb-api-key

# ── 路径映射（必填）───────────────────────────────────────
# source_root:  待整理的源目录根路径
# archive_root: 归档目标根路径（整理完成的剧集移入此处）
# library_root: 媒体库根路径（Emby/Jellyfin 扫描的路径）
MF_SOURCE_ROOT=/115/Library_incs/nas
MF_ARCHIVE_ROOT=/115/Library_incs/nas.finish
MF_LIBRARY_ROOT=/115/Library_incs/nas.finish

# ── 补缺选种与站点扩展配置（可选）─────────────────────────
# MF_GAP_FILL_MIN_SEEDERS=2
# MF_GAP_FILL_SEEDER_TIER_RATIO=0.10
# MF_GAP_FILL_MIN_SEEDER_SLACK=1
# MF_GAP_FILL_EXTRA_SITES=天空,观众
# MF_GAP_FILL_MIN_RESOLUTION=
# MF_GAP_FILL_REQUIRE_CHINESE=false
